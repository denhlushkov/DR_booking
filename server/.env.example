# Скопіюйте у .env і змініть значення за потреби.

PORT=3000

# memory — без БД (локальна розробка), postgres — робочий режим
DATA_STORE=memory
# DATABASE_URL=postgres://dr_booking:dr_booking@localhost:15432/dr_booking
# Застосовувати SQL-міграції з db/migrations під час старту
MIGRATE_ON_START=true

# Обовʼязково змінити в production!
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN_SECONDS=28800

# Створити демо-користувачів і ресурси (admin@company.com / Admin12345)
SEED_DEMO_DATA=true

# Правила офісу (хвилини)
BOOKING_MIN_MINUTES=30
BOOKING_MAX_MINUTES=720
BOOKING_CANCEL_CUTOFF_MINUTES=15

# Робочий графік: звіти завантаженості (FR-07) і формат дат у сповіщеннях (FR-11)
OFFICE_TIMEZONE=Europe/Kyiv
WORK_DAY_START=08:00
WORK_DAY_END=20:00
# 0 — неділя … 6 — субота
WORK_DAYS=1,2,3,4,5

# Нагадування та фонові задачі (FR-02, FR-11)
REMINDER_MINUTES_BEFORE=30
BACKGROUND_JOBS=true
JOB_INTERVAL_SECONDS=60
