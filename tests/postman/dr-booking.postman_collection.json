{
  "info": {
    "_postman_id": "5c1d1c2e-3b7a-4f0e-9a51-2a8e7b0d4c11",
    "name": "DR Booking — інтеграційні тести API",
    "description": "Наскрізна перевірка REST API інтегрованої системи (Nginx → API → PostgreSQL). Запуск: npm run test:api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Стан сервісу (NFR-03)",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('БД доступна', () => pm.expect(pm.response.json().checks.database).to.eql('up'));",
              "pm.test('Відповідь ≤ 300 мс (NFR-01)', () => pm.expect(pm.response.responseTime).to.be.below(300));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Вхід з невірним паролем → 401 (FR-01)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"{{employeeEmail}}\",\"password\":\"wrong-password\"}" },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.test('Повідомлення не розкриває, що email існує', () => pm.expect(pm.response.json().error.message).to.eql('Невірна електронна пошта або пароль'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Вхід співробітника (FR-01)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"{{employeeEmail}}\",\"password\":\"{{employeePassword}}\"}" },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK і JWT', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().token).to.be.a('string'); });",
              "pm.collectionVariables.set('employeeToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Вхід адміністратора (FR-01)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}" },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK, роль ADMIN', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().user.role).to.eql('ADMIN'); });",
              "pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Без токена → 401",
      "request": { "method": "GET", "url": "{{baseUrl}}/bookings/me" },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401', () => pm.response.to.have.status(401));"] } }
      ]
    },
    {
      "name": "06 Профіль користувача (FR-02)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }],
        "url": "{{baseUrl}}/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const me = pm.response.json();",
              "pm.test('ПІБ, посада, відділ', () => pm.expect(me).to.include.keys('fullName', 'position', 'department'));",
              "pm.test('Без хешу пароля (NFR-04)', () => pm.expect(me).to.not.have.property('passwordHash'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Пошук кімнат на 6 осіб (FR-09, FR-12)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/resources?type=MEETING_ROOM&participants=6",
          "host": ["{{baseUrl}}"],
          "path": ["resources"],
          "query": [
            { "key": "type", "value": "MEETING_ROOM" },
            { "key": "participants", "value": "6" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const rooms = pm.response.json();",
              "pm.test('Лише переговорні з місткістю ≥ 6', () => rooms.forEach(r => { pm.expect(r.type).to.eql('MEETING_ROOM'); pm.expect(r.attributes.capacity).to.be.at.least(6); }));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Співробітник не може додати ресурс → 403",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{employeeToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"name\":\"Нелегальний стіл\",\"type\":\"DESK\",\"floor\":1}" },
        "url": "{{baseUrl}}/resources"
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('403', () => pm.response.to.have.status(403));"] } }
      ]
    },
    {
      "name": "09 Адміністратор додає ресурс (FR-06)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"name\":\"Postman стіл {{$timestamp}}\",\"type\":\"DESK\",\"floor\":4,\"attributes\":{\"zone\":\"API\",\"equipment\":[\"monitor\"]}}" },
        "url": "{{baseUrl}}/resources"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Слот через 2 доби о 10:00 UTC — новий ресурс щоразу, тож конфліктів між прогонами немає.",
              "const start = new Date(Date.now() + 2 * 86400000); start.setUTCHours(10, 0, 0, 0);",
              "pm.collectionVariables.set('slotStart', start.toISOString());",
              "pm.collectionVariables.set('slotEnd', new Date(start.getTime() + 3600000).toISOString());",
              "pm.collectionVariables.set('shortEnd', new Date(start.getTime() + 75 * 60000).toISOString());",
              "pm.collectionVariables.set('movedStart', new Date(start.getTime() + 4 * 3600000).toISOString());",
              "pm.collectionVariables.set('movedEnd', new Date(start.getTime() + 5.5 * 3600000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created, статус AVAILABLE', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('AVAILABLE'); });",
              "pm.collectionVariables.set('deskId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Бронювання слота (FR-03)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{employeeToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"resourceId\":\"{{deskId}}\",\"startTime\":\"{{slotStart}}\",\"endTime\":\"{{slotEnd}}\"}" },
        "url": "{{baseUrl}}/bookings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created, CONFIRMED', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('CONFIRMED'); });",
              "pm.collectionVariables.set('bookingId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Повторне бронювання того ж слота → 409 (FR-04)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"resourceId\":\"{{deskId}}\",\"startTime\":\"{{slotStart}}\",\"endTime\":\"{{slotEnd}}\"}" },
        "url": "{{baseUrl}}/bookings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('Код CONFLICT', () => pm.expect(pm.response.json().error.code).to.eql('CONFLICT'));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Слот коротший за 30 хв → 400 (FR-03)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{employeeToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"resourceId\":\"{{deskId}}\",\"startTime\":\"{{slotEnd}}\",\"endTime\":\"{{shortEnd}}\"}" },
        "url": "{{baseUrl}}/bookings"
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 VALIDATION_ERROR', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'); });"] } }
      ]
    },
    {
      "name": "13 Календар ресурсу (FR-10)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/resources/{{deskId}}/schedule?from={{slotStart}}&to={{slotEnd}}",
          "host": ["{{baseUrl}}"],
          "path": ["resources", "{{deskId}}", "schedule"],
          "query": [
            { "key": "from", "value": "{{slotStart}}" },
            { "key": "to", "value": "{{slotEnd}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const slots = pm.response.json();",
              "pm.test('Зайнятий інтервал без персональних даних', () => { pm.expect(slots).to.have.lengthOf(1); pm.expect(slots[0]).to.have.all.keys('bookingId', 'startTime', 'endTime'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Перенесення бронювання",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{employeeToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"startTime\":\"{{movedStart}}\",\"endTime\":\"{{movedEnd}}\"}" },
        "url": "{{baseUrl}}/bookings/{{bookingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK, новий час', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().startTime).to.eql(pm.collectionVariables.get('movedStart')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Сповіщення користувача (FR-11)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }],
        "url": "{{baseUrl}}/notifications/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const inbox = pm.response.json();",
              "const forBooking = inbox.items.filter(n => n.bookingId === pm.collectionVariables.get('bookingId'));",
              "pm.test('Є сповіщення про створення і зміну', () => pm.expect(forBooking.map(n => n.type)).to.include.members(['BOOKING_CREATED', 'BOOKING_UPDATED']));",
              "pm.test('Сповіщення містить назву ресурсу і дату', () => { pm.expect(forBooking[0].message).to.include('Postman стіл'); pm.expect(forBooking[0].message).to.match(/\\d{2}\\.\\d{2}\\.\\d{4}, \\d{2}:\\d{2}–\\d{2}:\\d{2}/); });"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Блокування ресурсу скасовує бронювання (FR-06)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"status\":\"BLOCKED\"}" },
        "url": "{{baseUrl}}/resources/{{deskId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('Статус BLOCKED', () => pm.expect(body.resource.status).to.eql('BLOCKED'));",
              "pm.test('Скасовано 1 бронювання', () => pm.expect(body.cancelledBookings).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 Мої бронювання: статус CANCELLED (FR-02, FR-05)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }],
        "url": "{{baseUrl}}/bookings/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const booking = pm.response.json().find(b => b.id === pm.collectionVariables.get('bookingId'));",
              "pm.test('Бронювання скасоване примусово', () => pm.expect(booking.status).to.eql('CANCELLED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 Повернення ресурсу в роботу (FR-06)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"status\":\"AVAILABLE\"}" },
        "url": "{{baseUrl}}/resources/{{deskId}}/status"
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('AVAILABLE', () => pm.expect(pm.response.json().resource.status).to.eql('AVAILABLE'));"] } }
      ]
    },
    {
      "name": "19 Звіт завантаженості CSV (FR-07)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/analytics/utilization.csv?from={{slotStart}}&to={{movedEnd}}",
          "host": ["{{baseUrl}}"],
          "path": ["analytics", "utilization.csv"],
          "query": [
            { "key": "from", "value": "{{slotStart}}" },
            { "key": "to", "value": "{{movedEnd}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('text/csv', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'));",
              "pm.test('Колонки звіту', () => pm.expect(pm.response.text()).to.include('downtime_hours,utilization_percent'));"
            ]
          }
        }
      ]
    },
    {
      "name": "20 Співробітнику звіт недоступний → 403",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }],
        "url": "{{baseUrl}}/analytics/utilization?from=2026-12-01&to=2026-12-02"
      },
      "event": [
        { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('403', () => pm.response.to.have.status(403));"] } }
      ]
    }
  ],
  "variable": [
    { "key": "employeeToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "deskId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "slotStart", "value": "" },
    { "key": "slotEnd", "value": "" },
    { "key": "shortEnd", "value": "" },
    { "key": "movedStart", "value": "" },
    { "key": "movedEnd", "value": "" }
  ]
}
